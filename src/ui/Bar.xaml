<?xml version="1.0" encoding="utf-8"?>
<!-- The floating bar. Its brushes are animated from code when the track changes. -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Surface"
      Background="{DynamicResource BarBg}"
      TextElement.FontFamily="Segoe UI Variable Text, Segoe UI">
  <Grid.Resources>
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource BarFg}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BarHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BarPressed}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PlayBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource BarAccentFg}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="18" Background="{DynamicResource BarAccent}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <Grid Margin="8,8,6,8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <Grid x:Name="Cover" Width="48" Height="48" VerticalAlignment="Center" Background="Transparent">
      <Rectangle RadiusX="6" RadiusY="6" Fill="{DynamicResource BarHover}"/>
      <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BarFg2}"/>
      <Rectangle x:Name="CoverBack" RadiusX="6" RadiusY="6"/>
      <Rectangle x:Name="CoverFront" RadiusX="6" RadiusY="6" Opacity="0"/>
    </Grid>

    <StackPanel x:Name="Info" Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
      <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource BarFg}"/>
      <TextBlock x:Name="ArtistText" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource BarFg2}"/>
    </StackPanel>

    <Border x:Name="VisualizerHost" Grid.Column="2" Width="74" Height="30" Margin="0,0,10,0" VerticalAlignment="Center"/>

    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="PreviousButton" Style="{StaticResource IconBtn}" Content="&#xE892;" ToolTip="Précédent"/>
      <Button x:Name="ToggleButton" Style="{StaticResource PlayBtn}" Content="&#xE768;" Margin="3,0,3,0" ToolTip="Lecture ou pause"/>
      <Button x:Name="NextButton" Style="{StaticResource IconBtn}" Content="&#xE893;" ToolTip="Suivant"/>
    </StackPanel>

    <!-- Two small buttons stacked, so the bar keeps its width. -->
    <StackPanel Grid.Column="4" Margin="4,0,0,0" VerticalAlignment="Center">
      <Button x:Name="VolumeButton" Style="{StaticResource IconBtn}" Content="&#xE995;" FontSize="12" Width="24" Height="23" ToolTip="Volume"/>
      <Button x:Name="SettingsButton" Style="{StaticResource IconBtn}" Content="&#xE713;" FontSize="11.5" Width="24" Height="23" Margin="0,2,0,0" ToolTip="Paramètres"/>
    </StackPanel>
  </Grid>

  <!-- Timeline: thin at rest, thicker with a handle when it can be dragged. -->
  <Grid x:Name="SeekZone" Height="10" VerticalAlignment="Bottom" Background="Transparent">
    <Border x:Name="ProgressRail" Height="4" Margin="0,0,0,3" VerticalAlignment="Bottom" Background="{DynamicResource BarHover}" Visibility="Collapsed"/>
    <!-- Moved with transforms only: following the track never triggers a layout pass. -->
    <Border x:Name="ProgressFill" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource BarAccent}">
      <Border.RenderTransform><ScaleTransform x:Name="ProgressScale" ScaleX="0"/></Border.RenderTransform>
    </Border>
    <Ellipse x:Name="SeekHandle" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
             Fill="{DynamicResource BarAccent}" Visibility="Collapsed" IsHitTestVisible="False">
      <Ellipse.RenderTransform><TranslateTransform x:Name="HandleShift"/></Ellipse.RenderTransform>
    </Ellipse>
  </Grid>
  <!-- Volume: a small panel that opens above the bar (below it when there is no room). -->
  <Popup x:Name="VolumePopup" AllowsTransparency="True" StaysOpen="True" Placement="Custom" PopupAnimation="Fade">
    <Border x:Name="VolumeCard" Width="230" CornerRadius="8" Padding="8,7,12,9" Margin="0"
            Background="{DynamicResource BarPanel}" BorderThickness="1" BorderBrush="{DynamicResource BarHover}"
            TextElement.FontFamily="Segoe UI Variable Text, Segoe UI">
      <Grid x:Name="VolumePanel" Background="Transparent">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
          <Button x:Name="MuteButton" Style="{StaticResource IconBtn}" Width="22" Height="20" FontSize="12" Content="&#xE995;" ToolTip="Couper le son"/>
          <TextBlock x:Name="VolumeValue" DockPanel.Dock="Right" FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource BarFg2}"/>
          <TextBlock x:Name="VolumeTarget" FontSize="12" FontWeight="SemiBold" Margin="3,0,6,0" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Cursor="Hand" Foreground="{DynamicResource BarFg}"/>
        </DockPanel>
        <Grid x:Name="VolumeTrack" Grid.Row="1" Height="14" Margin="4,4,0,0" Background="Transparent" Cursor="Hand">
          <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource BarHover}"/>
          <Border x:Name="VolumeFill" Height="4" Width="0" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                  Background="{DynamicResource BarAccent}"/>
          <Ellipse x:Name="VolumeKnob" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center"
                   Fill="{DynamicResource BarAccent}" IsHitTestVisible="False"/>
        </Grid>
      </Grid>
    </Border>
  </Popup>
</Grid>