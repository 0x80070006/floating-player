<?xml version="1.0" encoding="utf-8"?>
<!-- The floating bar. Its brushes are animated from code when the track changes. -->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="Surface"
      Background="{DynamicResource BarBg}"
      TextElement.FontFamily="Segoe UI Variable Text, Segoe UI">
  <Grid.Resources>
    <Style x:Key="IconBtn" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource BarFg}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BarHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BarPressed}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PlayBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{DynamicResource BarAccentFg}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="18" Background="{DynamicResource BarAccent}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.72"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <Grid Margin="8,8,6,8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <Grid Width="48" Height="48" VerticalAlignment="Center">
      <Rectangle RadiusX="6" RadiusY="6" Fill="{DynamicResource BarHover}"/>
      <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                 HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BarFg2}"/>
      <Rectangle x:Name="CoverBack" RadiusX="6" RadiusY="6"/>
      <Rectangle x:Name="CoverFront" RadiusX="6" RadiusY="6" Opacity="0"/>
    </Grid>

    <StackPanel x:Name="Info" Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
      <TextBlock x:Name="TitleText" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource BarFg}"/>
      <TextBlock x:Name="ArtistText" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource BarFg2}"/>
    </StackPanel>

    <Border x:Name="VisualizerHost" Grid.Column="2" Width="74" Height="30" Margin="0,0,10,0" VerticalAlignment="Center"/>

    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="PreviousButton" Style="{StaticResource IconBtn}" Content="&#xE892;" ToolTip="Précédent"/>
      <Button x:Name="ToggleButton" Style="{StaticResource PlayBtn}" Content="&#xE768;" Margin="3,0,3,0" ToolTip="Lecture ou pause"/>
      <Button x:Name="NextButton" Style="{StaticResource IconBtn}" Content="&#xE893;" ToolTip="Suivant"/>
    </StackPanel>

    <Button x:Name="SettingsButton" Grid.Column="4" Style="{StaticResource IconBtn}" Content="&#xE713;"
            FontSize="12" Width="26" Height="26" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="Paramètres"/>
  </Grid>

  <!-- Timeline: thin at rest, thicker with a handle when it can be dragged. -->
  <Grid x:Name="SeekZone" Height="10" VerticalAlignment="Bottom" Background="Transparent">
    <Border x:Name="ProgressRail" Height="4" Margin="0,0,0,3" VerticalAlignment="Bottom" Background="{DynamicResource BarHover}" Visibility="Collapsed"/>
    <Border x:Name="ProgressFill" Height="2" Width="0" HorizontalAlignment="Left" VerticalAlignment="Bottom"
            Background="{DynamicResource BarAccent}"/>
    <Ellipse x:Name="SeekHandle" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom"
             Fill="{DynamicResource BarAccent}" Visibility="Collapsed" IsHitTestVisible="False"/>
  </Grid>
</Grid>
