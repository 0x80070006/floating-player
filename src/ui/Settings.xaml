<?xml version="1.0" encoding="utf-8"?>
<!-- Settings panel. Colors come from SettingsWindow as dynamic resources. -->
<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        BorderThickness="1" BorderBrush="{DynamicResource CardStroke}" Background="{DynamicResource WinBg}"
        TextElement.FontFamily="Segoe UI Variable Text, Segoe UI"
        TextElement.FontSize="13"
        TextElement.Foreground="{DynamicResource Fg1}">
  <Border.Resources>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
      <Setter Property="Margin" Value="2,14,0,5"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardStroke}"/>
    </Style>
    <Style x:Key="Separator" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource CardStroke}"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Margin" Value="0,1,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
    </Style>
    <Style x:Key="Row" TargetType="Grid">
      <Setter Property="Margin" Value="12,8"/>
      <Setter Property="MinHeight" Value="24"/>
    </Style>

    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="36" Height="18" Background="Transparent">
              <Border x:Name="Track" CornerRadius="9" BorderThickness="1"
                      BorderBrush="{DynamicResource TrackStroke}" Background="{DynamicResource ControlBg}"/>
              <Ellipse x:Name="Knob" Width="10" Height="10" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Fill="{DynamicResource Fg2}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentFg}"/>
                <Setter TargetName="Knob" Property="Margin" Value="22,0,0,0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RailFill" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent">
              <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center" Background="{DynamicResource Accent}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RailEmpty" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Grid Background="Transparent">
              <Border Height="3" CornerRadius="1.5" VerticalAlignment="Center" Background="{DynamicResource TrackRail}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SliderThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Ellipse Width="14" Height="14" Fill="{DynamicResource Accent}" Stroke="{DynamicResource WinBg}" StrokeThickness="2"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="FluentSlider" TargetType="Slider">
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Width" Value="130"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Track x:Name="PART_Track" Height="22">
              <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource RailFill}"/></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource RailEmpty}"/></Track.IncreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource SliderThumb}"/></Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg2}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="4" Padding="9,3,9,4" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThumbBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource Fg1}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Width="4" CornerRadius="2" HorizontalAlignment="Center" Background="{DynamicResource TrackRail}"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Fg1}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="4" Padding="10,3,10,4" BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStroke}" Background="{DynamicResource ControlBg}">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Border.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel x:Name="Header" Margin="16,12,10,0" Background="Transparent">
      <Button x:Name="CloseButton" DockPanel.Dock="Right" Width="26" Height="26" Focusable="False" Cursor="Hand"
              Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" ToolTip="Fermer"
              Foreground="{DynamicResource Fg1}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="4" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
      <TextBlock Text="Paramètres" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </DockPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
      <StackPanel Margin="14,0,14,4">

        <TextBlock Text="Couleur" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Couleur de la barre" VerticalAlignment="Center"/>
              <Border Grid.Column="1" CornerRadius="5" Padding="2" BorderThickness="1"
                      BorderBrush="{DynamicResource ControlStroke}" Background="{DynamicResource ControlBg}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="ColorCover" GroupName="Color" Content="Jaquette" Style="{StaticResource Segment}"/>
                  <RadioButton x:Name="ColorCustom" GroupName="Color" Content="Personnalisée" Style="{StaticResource Segment}"/>
                </StackPanel>
              </Border>
            </Grid>
            <Grid x:Name="CustomRow" Margin="12,0,12,10">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <WrapPanel x:Name="Swatches" VerticalAlignment="Center"/>
              <TextBox x:Name="HexBox" Grid.Column="1" Width="72" Height="24" MaxLength="7" VerticalContentAlignment="Center" Padding="3,0"
                       CharacterCasing="Upper" BorderThickness="1" FontSize="12"
                       Foreground="{DynamicResource Fg1}" CaretBrush="{DynamicResource Fg1}"
                       Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource ControlStroke}"/>
            </Grid>
            <Border Style="{StaticResource Separator}"/>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Opacité" VerticalAlignment="Center"/>
              <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="40" Maximum="100" Style="{StaticResource FluentSlider}"/>
              <TextBlock x:Name="OpacityValue" Grid.Column="2" Style="{StaticResource Value}"/>
            </Grid>
            <Border Style="{StaticResource Separator}"/>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Flou derrière la barre" VerticalAlignment="Center"/>
              <CheckBox x:Name="BlurSwitch" Grid.Column="1" Style="{StaticResource Switch}"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="Affichage" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Taille" VerticalAlignment="Center"/>
              <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="80" Maximum="150" Style="{StaticResource FluentSlider}"/>
              <TextBlock x:Name="ScaleValue" Grid.Column="2" Style="{StaticResource Value}"/>
            </Grid>
            <Border Style="{StaticResource Separator}"/>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Largeur" VerticalAlignment="Center"/>
              <Slider x:Name="WidthSlider" Grid.Column="1" Minimum="340" Maximum="640" Style="{StaticResource FluentSlider}"/>
              <TextBlock x:Name="WidthValue" Grid.Column="2" Style="{StaticResource Value}"/>
            </Grid>
            <Border Style="{StaticResource Separator}"/>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Visualizer" VerticalAlignment="Center"/>
              <CheckBox x:Name="VisualizerSwitch" Grid.Column="1" Style="{StaticResource Switch}"/>
            </Grid>
            <Grid x:Name="SensitivityRow" Margin="12,0,12,8">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Sensibilité" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0"/>
              <Slider x:Name="SensitivitySlider" Grid.Column="1" Minimum="50" Maximum="160" Style="{StaticResource FluentSlider}"/>
              <TextBlock x:Name="SensitivityValue" Grid.Column="2" Style="{StaticResource Value}"/>
            </Grid>
            <Border Style="{StaticResource Separator}"/>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Barre de progression" VerticalAlignment="Center"/>
              <CheckBox x:Name="ProgressSwitch" Grid.Column="1" Style="{StaticResource Switch}"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="Comportement" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Toujours au premier plan" VerticalAlignment="Center"/>
              <CheckBox x:Name="TopmostSwitch" Grid.Column="1" Style="{StaticResource Switch}"/>
            </Grid>
            <Border Style="{StaticResource Separator}"/>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Masquer" VerticalAlignment="Center"/>
              <Border Grid.Column="1" CornerRadius="5" Padding="2" BorderThickness="1"
                      BorderBrush="{DynamicResource ControlStroke}" Background="{DynamicResource ControlBg}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="HideNever" GroupName="Hide" Content="Jamais" Style="{StaticResource Segment}"/>
                  <RadioButton x:Name="HideNoMedia" GroupName="Hide" Content="Sans média" Style="{StaticResource Segment}"/>
                  <RadioButton x:Name="HidePaused" GroupName="Hide" Content="En pause" Style="{StaticResource Segment}"/>
                </StackPanel>
              </Border>
            </Grid>
            <Border Style="{StaticResource Separator}"/>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Masquer en plein écran"/>
                <TextBlock Text="Vidéo, jeu ou présentation sur le même écran" Style="{StaticResource Hint}"/>
              </StackPanel>
              <CheckBox x:Name="FullscreenSwitch" Grid.Column="1" Style="{StaticResource Switch}"/>
            </Grid>
            <Border Style="{StaticResource Separator}"/>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Volume réglé"/>
                <TextBlock Text="Molette sur la barre : ±2 %" Style="{StaticResource Hint}"/>
              </StackPanel>
              <Border Grid.Column="1" CornerRadius="5" Padding="2" BorderThickness="1" VerticalAlignment="Center"
                      BorderBrush="{DynamicResource ControlStroke}" Background="{DynamicResource ControlBg}">
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="VolumeApp" GroupName="Volume" Content="Application" Style="{StaticResource Segment}"/>
                  <RadioButton x:Name="VolumeSystem" GroupName="Volume" Content="Système" Style="{StaticResource Segment}"/>
                </StackPanel>
              </Border>
            </Grid>
            <Border Style="{StaticResource Separator}"/>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Verrouiller la position"/>
                <TextBlock Text="Sinon, glissez-la : elle s'aimante aux bords" Style="{StaticResource Hint}"/>
              </StackPanel>
              <CheckBox x:Name="LockSwitch" Grid.Column="1" Style="{StaticResource Switch}"/>
            </Grid>
            <Border Style="{StaticResource Separator}"/>
            <Grid Style="{StaticResource Row}">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="Lancer au démarrage de Windows" VerticalAlignment="Center"/>
              <CheckBox x:Name="LaunchSwitch" Grid.Column="1" Style="{StaticResource Switch}"/>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="2" Margin="14,10,14,14" LastChildFill="False">
      <Button x:Name="ResetButton" DockPanel.Dock="Left" Content="Réinitialiser" Style="{StaticResource Btn}"/>
      <Button x:Name="RecenterButton" DockPanel.Dock="Left" Content="Recentrer" Margin="6,0,0,0" Style="{StaticResource Btn}"/>
      <Button x:Name="QuitButton" DockPanel.Dock="Right" Content="Quitter l'app" Style="{StaticResource Btn}"/>
    </DockPanel>
  </Grid>
</Border>
